#!/usr/bin/env bash
#
# secret — give a credential to a process without giving it to the transcript.
#
set -euo pipefail

# Resolve the real install directory, following however many symlinks.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _dir="$(cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  case "$_self" in /*) ;; *) _self="$_dir/$_self" ;; esac
done
ROOT="$(cd -P "$(dirname "$_self")/.." && pwd)"
export SECRET_CLI_ROOT="$ROOT"

# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
# shellcheck source=../lib/store_keychain.sh
. "$ROOT/lib/store_keychain.sh"

INDEX="$SECRET_CLI_HOME/keys"
ADOPTED="$SECRET_CLI_HOME/adopted"

usage() {
  cat <<EOF
usage: secret <command> [args]

  set <KEY>                 store a new secret; the value is prompted for and never echoed
  update <KEY>              replace the value of an existing secret
  rm <KEY>                  forget a secret
  list [--all] [filter]     print names, never values. --all includes keychain
                            items this tool did not create. A filter matches a
                            substring, the initials of the snake_case parts
                            (TIC finds THIS_IS_COOL), or letters in order
  show <KEY>                show the value in a macOS dialog — on screen for
                            you, never in the terminal and never in an
                            agent's tool output
  adopt <service>           make an item another application created usable by
        [--as KEY]          run. Read only: never changed, never deleted
        [--account ACCOUNT]
  run <KEY>... -- <cmd>     run <cmd> with the secrets in its environment,
                            scrubbing the values out of everything it prints
  init [host]               install the guard hook into an agent's config
  help                      this text

  --version                 print the version

Values are held in $(store_name). Nothing writes a value to the terminal.
EOF
}

# --- index -----------------------------------------------------------------
# Names only. The values live in the keychain; this is just so `list` does not
# have to dump the whole keychain to find out what belongs to us.

index_read() { [ -f "$INDEX" ] && cat "$INDEX" || true; }

index_add() {
  ensure_home
  { index_read; printf '%s\n' "$1"; } | sort -u | grep -v '^$' > "$INDEX.tmp"
  mv "$INDEX.tmp" "$INDEX"
}

index_del() {
  ensure_home
  index_read | grep -vx -- "$1" > "$INDEX.tmp" || true
  mv "$INDEX.tmp" "$INDEX"
}

index_has() { index_read | grep -qx -- "$1"; }

# --- adopted items ----------------------------------------------------------
# An item another application created, which we may read and forget, but never
# change or delete. One line per key: KEY<tab>service<tab>account.

adopted_read() { [ -f "$ADOPTED" ] && cat "$ADOPTED" || true; }
adopted_lookup() { adopted_read | grep -- "^$1	" || true; }
adopted_has() { [ -n "$(adopted_lookup "$1")" ]; }

adopted_add() {
  ensure_home
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$ADOPTED"
}

adopted_del() {
  ensure_home
  adopted_read | grep -v -- "^$1	" > "$ADOPTED.tmp" || true
  mv "$ADOPTED.tmp" "$ADOPTED"
}

listing() { python3 "$ROOT/lib/listing.py" "$@"; }

# --- commands ---------------------------------------------------------------

cmd_set() {
  [ $# -ge 1 ] || die "usage: secret set <KEY>"
  [ $# -eq 1 ] || die "secret set takes only a key — the value is read from stdin, never the command line"
  require_key "$1"
  store_check
  ! adopted_has "$1" || die "'$1' is adopted from another application — pick another name"
  if store_has "$1" || index_has "$1"; then
    die "'$1' already exists — use 'secret update $1' to change it"
  fi
  _store_from_stdin "$1"
  info "stored $1"
}

cmd_update() {
  [ $# -ge 1 ] || die "usage: secret update <KEY>"
  [ $# -eq 1 ] || die "secret update takes only a key — the value is read from stdin, never the command line"
  require_key "$1"
  store_check
  ! adopted_has "$1" ||
    die "'$1' was adopted from another application — this tool will not write to its item. Change it where it came from, or 'secret rm $1' and store your own."
  if ! store_has "$1"; then
    die "'$1' does not exist — use 'secret set $1' to create it"
  fi
  _store_from_stdin "$1"
  info "updated $1"
}

_store_from_stdin() {
  local key="$1" value
  value="$(read_value "$key")"
  [ -n "$value" ] || die "refusing to store an empty value for $key"
  if [ "${#value}" -lt "$SECRET_CLI_MIN_SCRUB_LEN" ]; then
    warn "$key is shorter than $SECRET_CLI_MIN_SCRUB_LEN characters, too short to scrub safely — 'secret run' will not redact it"
  fi
  printf '%s' "$value" | store_put "$key"
  index_add "$key"
}

cmd_rm() {
  [ $# -eq 1 ] || die "usage: secret rm <KEY>"
  store_check
  if adopted_has "$1"; then
    # The item belongs to another application. Forget the mapping; leave it.
    adopted_del "$1"
    index_del "$1"
    info "forgot $1 — the keychain item itself was left alone"
    return 0
  fi
  if ! store_has "$1" && ! index_has "$1"; then
    die "no such secret: $1"
  fi
  store_del "$1"
  index_del "$1"
  info "removed $1"
}

cmd_list() {
  local all=0 query=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --all|-a) all=1; shift ;;
      -*) die "unknown option for list: $1" ;;
      *) [ -z "$query" ] || die "usage: secret list [--all] [filter]"; query="$1"; shift ;;
    esac
  done
  store_check

  if [ "$all" -eq 1 ]; then
    listing list --all --filter "$query"
    return 0
  fi

  # Plain list is bare names, one per line, so it can drive a loop. A managed
  # key whose keychain item has gone is called out rather than silently listed.
  local key
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    if adopted_has "$key" || store_has "$key"; then
      printf '%s\n' "$key"
    else
      printf '%s  (missing from the keychain)\n' "$key"
    fi
  done <<EOF
$(listing list --filter "$query")
EOF
}

cmd_adopt() {
  local service="" as="" account=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --as) as="${2:-}"; shift 2 ;;
      --account) account="${2:-}"; shift 2 ;;
      -*) die "unknown option for adopt: $1" ;;
      *) service="$1"; shift ;;
    esac
  done
  [ -n "$service" ] || die "usage: secret adopt <service> [--as KEY] [--account ACCOUNT]"
  store_check

  if [ -z "$account" ]; then
    local accounts count
    accounts="$(listing accounts "$service")"
    count="$(printf '%s' "$accounts" | grep -c . || true)"
    [ "$count" != "0" ] || die "no keychain item with service '$service'"
    [ "$count" = "1" ] ||
      die "service '$service' has $count accounts — pick one with --account: $(printf '%s' "$accounts" | tr '\n' ' ')"
    account="$accounts"
  fi

  store_has_foreign "$service" "$account" ||
    die "no keychain item with service '$service' and account '$account'"

  local key="${as:-$service}"
  valid_key "$key" ||
    die "'$key' is not usable as an environment variable name — give one with --as"
  ! store_has "$key" || die "'$key' is already a secret this tool manages"
  ! adopted_has "$key" || die "'$key' is already adopted"

  adopted_add "$key" "$service" "$account"
  index_add "$key"
  info "adopted $service as $key (read only — this tool will not change or delete it)"
}

cmd_show() {
  [ $# -eq 1 ] || die "usage: secret show <KEY>"
  require_key "$1"
  store_check
  _resolvable "$1" || die "no such secret: $1"

  local value
  value="$(_resolve_value "$1")" || die "could not read '$1' from the keychain"

  # The value goes to the display on stdin, never on a command line, and never
  # to stdout or stderr. SECRET_CLI_SHOW_CMD swaps the display out.
  if [ -n "${SECRET_CLI_SHOW_CMD:-}" ]; then
    printf '%s' "$value" | SECRET_CLI_SHOW_KEY="$1" sh -c "$SECRET_CLI_SHOW_CMD"
    return $?
  fi

  command -v osascript >/dev/null 2>&1 ||
    die "no way to display a value here — set SECRET_CLI_SHOW_CMD to a command that takes it on stdin"

  # The script reaches osascript on stdin, so the value is not in the process
  # table either. AppleScript string literals need \ and " escaped.
  local escaped
  escaped="$(printf '%s' "$value" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
  osascript - <<APPLESCRIPT >/dev/null
display dialog "$escaped" with title "secret: $1" buttons {"Done"} default button "Done"
APPLESCRIPT
}

# The value for a key, whichever kind it is.
_resolve_value() {
  local line
  line="$(adopted_lookup "$1")"
  if [ -n "$line" ]; then
    store_get_foreign "$(printf '%s' "$line" | cut -f2)" "$(printf '%s' "$line" | cut -f3)"
  else
    store_get "$1"
  fi
}

_resolvable() {
  adopted_has "$1" || store_has "$1"
}

cmd_run() {
  local keys=() scrub=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; break ;;
      --no-scrub) scrub=0; shift ;;
      -*) die "unknown option for run: $1" ;;
      *) keys+=("$1"); shift ;;
    esac
  done
  [ "${#keys[@]}" -gt 0 ] || die "usage: secret run <KEY>... -- <command>"
  [ $# -gt 0 ] || die "no command given — usage: secret run <KEY>... -- <command>"

  store_check
  local key value
  for key in "${keys[@]}"; do
    require_key "$key"
    _resolvable "$key" || die "no such secret: $key"
    value="$(_resolve_value "$key")" || die "could not read '$key' from the keychain"
    export "$key=$value"
  done

  if [ "$scrub" -eq 0 ]; then
    warn "--no-scrub: the command's output is not being scrubbed"
    exec "$@"
  fi

  SECRET_CLI_KEYS="$(IFS=,; printf '%s' "${keys[*]}")" \
    exec python3 "$ROOT/lib/run.py" "$@"
}

cmd_init() {
  local host="" yes=0 dry=0 uninstall=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --list-hosts) _list_hosts; return 0 ;;
      --yes|-y) yes=1; shift ;;
      --dry-run|-n) dry=1; shift ;;
      --uninstall) uninstall=1; shift ;;
      -*) die "unknown option for init: $1" ;;
      *) host="$1"; shift ;;
    esac
  done

  [ -n "$host" ] || host="claude-code"
  local plugin="$ROOT/hosts/$host.sh"
  [ -f "$plugin" ] ||
    die "no support for host '$host' — try 'secret init --list-hosts'"
  # shellcheck source=/dev/null
  . "$plugin"

  if [ "$uninstall" -eq 1 ]; then
    host_describe_uninstall
    _confirm "$yes" "$dry" "Remove it?" || return 0
    host_uninstall
    return 0
  fi

  host_describe_install
  _confirm "$yes" "$dry" "Apply this?" || return 0
  host_install
}

_list_hosts() {
  local f
  for f in "$ROOT"/hosts/*.sh; do
    [ -f "$f" ] || continue
    printf '%s\n' "$(basename "$f" .sh)"
  done
}

# Returns non-zero when the caller should stop: a dry run, or a refusal.
_confirm() {
  local yes="$1" dry="$2" question="$3" answer
  [ "$dry" -eq 0 ] || { info ""; info "(dry run — nothing was changed)"; return 1; }
  [ "$yes" -eq 0 ] || return 0
  printf '\n%s [y/N] ' "$question"
  IFS= read -r answer || answer=""
  case "$answer" in
    y|Y|yes|YES) return 0 ;;
    *) info "nothing changed"; return 1 ;;
  esac
}

# --- dispatch ---------------------------------------------------------------

case "${1:-}" in
  set|update|rm|list|run|init|adopt|show)
    cmd="$1"; shift; "cmd_$cmd" "$@" ;;
  help|--help|-h)
    usage ;;
  version|--version|-V)
    printf 'secret %s\n' "$SECRET_CLI_VERSION" ;;
  "")
    usage >&2; exit 2 ;;
  *)
    printf 'secret: unknown command: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
esac
