#!/usr/bin/env bash
#
# secret — give a credential to a process without giving it to the transcript.
#
set -euo pipefail

# Resolve the real install directory, following however many symlinks.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do
  _dir="$(cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  case "$_self" in /*) ;; *) _self="$_dir/$_self" ;; esac
done
ROOT="$(cd -P "$(dirname "$_self")/.." && pwd)"
export SECRET_CLI_ROOT="$ROOT"

# shellcheck source=../lib/common.sh
. "$ROOT/lib/common.sh"
# shellcheck source=../lib/store_keychain.sh
. "$ROOT/lib/store_keychain.sh"

INDEX="$SECRET_CLI_HOME/keys"

usage() {
  cat <<EOF
usage: secret <command> [args]

  set <KEY>                 store a new secret; the value is prompted for and never echoed
  update <KEY>              replace the value of an existing secret
  rm <KEY>                  forget a secret
  list                      print the names of stored secrets, never the values
  run <KEY>... -- <cmd>     run <cmd> with the secrets in its environment,
                            scrubbing the values out of everything it prints
  init [host]               install the guard hook into an agent's config
  help                      this text

  --version                 print the version

Values are held in $(store_name). Nothing writes a value to the terminal.
EOF
}

# --- index -----------------------------------------------------------------
# Names only. The values live in the keychain; this is just so `list` does not
# have to dump the whole keychain to find out what belongs to us.

index_read() { [ -f "$INDEX" ] && cat "$INDEX" || true; }

index_add() {
  ensure_home
  { index_read; printf '%s\n' "$1"; } | sort -u | grep -v '^$' > "$INDEX.tmp"
  mv "$INDEX.tmp" "$INDEX"
}

index_del() {
  ensure_home
  index_read | grep -vx -- "$1" > "$INDEX.tmp" || true
  mv "$INDEX.tmp" "$INDEX"
}

index_has() { index_read | grep -qx -- "$1"; }

# --- commands ---------------------------------------------------------------

cmd_set() {
  [ $# -ge 1 ] || die "usage: secret set <KEY>"
  [ $# -eq 1 ] || die "secret set takes only a key — the value is read from stdin, never the command line"
  require_key "$1"
  store_check
  if store_has "$1" || index_has "$1"; then
    die "'$1' already exists — use 'secret update $1' to change it"
  fi
  _store_from_stdin "$1"
  info "stored $1"
}

cmd_update() {
  [ $# -ge 1 ] || die "usage: secret update <KEY>"
  [ $# -eq 1 ] || die "secret update takes only a key — the value is read from stdin, never the command line"
  require_key "$1"
  store_check
  if ! store_has "$1"; then
    die "'$1' does not exist — use 'secret set $1' to create it"
  fi
  _store_from_stdin "$1"
  info "updated $1"
}

_store_from_stdin() {
  local key="$1" value
  value="$(read_value "$key")"
  [ -n "$value" ] || die "refusing to store an empty value for $key"
  if [ "${#value}" -lt "$SECRET_CLI_MIN_SCRUB_LEN" ]; then
    warn "$key is shorter than $SECRET_CLI_MIN_SCRUB_LEN characters, too short to scrub safely — 'secret run' will not redact it"
  fi
  printf '%s' "$value" | store_put "$key"
  index_add "$key"
}

cmd_rm() {
  [ $# -eq 1 ] || die "usage: secret rm <KEY>"
  store_check
  if ! store_has "$1" && ! index_has "$1"; then
    die "no such secret: $1"
  fi
  store_del "$1"
  index_del "$1"
  info "removed $1"
}

cmd_list() {
  [ $# -eq 0 ] || die "usage: secret list"
  store_check
  local key
  while IFS= read -r key; do
    [ -n "$key" ] || continue
    if store_has "$key"; then
      printf '%s\n' "$key"
    else
      printf '%s  (missing from the keychain)\n' "$key"
    fi
  done <<EOF
$(index_read)
EOF
}

cmd_run() {
  local keys=() scrub=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; break ;;
      --no-scrub) scrub=0; shift ;;
      -*) die "unknown option for run: $1" ;;
      *) keys+=("$1"); shift ;;
    esac
  done
  [ "${#keys[@]}" -gt 0 ] || die "usage: secret run <KEY>... -- <command>"
  [ $# -gt 0 ] || die "no command given — usage: secret run <KEY>... -- <command>"

  store_check
  local key value
  for key in "${keys[@]}"; do
    require_key "$key"
    store_has "$key" || die "no such secret: $key"
    value="$(store_get "$key")" || die "could not read '$key' from the keychain"
    export "$key=$value"
  done

  if [ "$scrub" -eq 0 ]; then
    warn "--no-scrub: the command's output is not being scrubbed"
    exec "$@"
  fi

  SECRET_CLI_KEYS="$(IFS=,; printf '%s' "${keys[*]}")" \
    exec python3 "$ROOT/lib/run.py" "$@"
}

cmd_init() {
  local host="" yes=0 dry=0 uninstall=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --list-hosts) _list_hosts; return 0 ;;
      --yes|-y) yes=1; shift ;;
      --dry-run|-n) dry=1; shift ;;
      --uninstall) uninstall=1; shift ;;
      -*) die "unknown option for init: $1" ;;
      *) host="$1"; shift ;;
    esac
  done

  [ -n "$host" ] || host="claude-code"
  local plugin="$ROOT/hosts/$host.sh"
  [ -f "$plugin" ] ||
    die "no support for host '$host' — try 'secret init --list-hosts'"
  # shellcheck source=/dev/null
  . "$plugin"

  if [ "$uninstall" -eq 1 ]; then
    host_describe_uninstall
    _confirm "$yes" "$dry" "Remove it?" || return 0
    host_uninstall
    return 0
  fi

  host_describe_install
  _confirm "$yes" "$dry" "Apply this?" || return 0
  host_install
}

_list_hosts() {
  local f
  for f in "$ROOT"/hosts/*.sh; do
    [ -f "$f" ] || continue
    printf '%s\n' "$(basename "$f" .sh)"
  done
}

# Returns non-zero when the caller should stop: a dry run, or a refusal.
_confirm() {
  local yes="$1" dry="$2" question="$3" answer
  [ "$dry" -eq 0 ] || { info ""; info "(dry run — nothing was changed)"; return 1; }
  [ "$yes" -eq 0 ] || return 0
  printf '\n%s [y/N] ' "$question"
  IFS= read -r answer || answer=""
  case "$answer" in
    y|Y|yes|YES) return 0 ;;
    *) info "nothing changed"; return 1 ;;
  esac
}

# --- dispatch ---------------------------------------------------------------

case "${1:-}" in
  set|update|rm|list|run|init)
    cmd="$1"; shift; "cmd_$cmd" "$@" ;;
  help|--help|-h)
    usage ;;
  version|--version|-V)
    printf 'secret %s\n' "$SECRET_CLI_VERSION" ;;
  "")
    usage >&2; exit 2 ;;
  *)
    printf 'secret: unknown command: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
esac
