{"desc":"direct keychain read by service name","tool_name":"Bash","tool_input":{"command":"security find-generic-password -w -s secret-cli.TOKEN"}}
{"desc":"keychain read with account and service reordered","tool_name":"Bash","tool_input":{"command":"security -q find-generic-password -a $USER -s secret-cli.TOKEN -w"}}
{"desc":"keychain read by absolute path to the binary","tool_name":"Bash","tool_input":{"command":"/usr/bin/security find-generic-password -w -s secret-cli.TOKEN"}}
{"desc":"keychain read with irregular whitespace","tool_name":"Bash","tool_input":{"command":"security    find-generic-password   -w  -s  secret-cli.TOKEN"}}
{"desc":"keychain read hidden behind a pipeline","tool_name":"Bash","tool_input":{"command":"echo hi && security find-generic-password -w -s secret-cli.TOKEN | tee /tmp/x"}}
{"desc":"internet password read","tool_name":"Bash","tool_input":{"command":"security find-internet-password -w -s github.com"}}
{"desc":"whole keychain dump","tool_name":"Bash","tool_input":{"command":"security dump-keychain -d"}}
{"desc":"keychain export","tool_name":"Bash","tool_input":{"command":"security export -k login.keychain -t certs"}}
{"desc":"reading the keychain file directly","tool_name":"Bash","tool_input":{"command":"cat ~/Library/Keychains/login.keychain-db"}}
